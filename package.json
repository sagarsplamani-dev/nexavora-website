{
  "name": "nexavora-technologies",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "lint": "npm run lint -w client",
    "test:api": "npm run test:api -w server",
    "format": "prettier --write client/src/pages/Home.jsx client/src/sections/DataScienceSection.jsx",
    "start": "npm start -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prettier": "^3.4.2"
  }
}
